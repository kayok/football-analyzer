# Copy to .env.docker. Development placeholders: change the password for VPS use.
POSTGRES_DB=football
POSTGRES_USER=football
POSTGRES_PASSWORD=change_this_password
# Match the credentials above. URL-encode special characters in this URL only.
DOCKER_DATABASE_URL=postgres://football:change_this_password@postgres:5432/football?sslmode=disable
OWNER_EMAIL=owner@example.com
OWNER_NAME=Owner
WEB_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
APP_TIMEZONE=Asia/Bangkok
PLAY_EV_THRESHOLD=0.05
ODDS_MAX_AGE=15m
FOOTBALL_PROVIDER=mock
API_FOOTBALL_KEY=
API_FOOTBALL_LEAGUES=39,140,135,78,61
API_FOOTBALL_MAX_REQUESTS=50
SYNC_AUTO_ENABLED=true
SYNC_INTERVAL=24h
SYNC_COOLDOWN=30m
